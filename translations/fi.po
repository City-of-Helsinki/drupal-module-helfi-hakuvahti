msgid ""
msgstr ""

msgid "Hakuvahti settings"
msgstr "Hakuvahdin asetukset"

msgid "Confirm search alert"
msgstr "Hakuvahdin vahvistaminen"

msgid "Remove search alert"
msgstr "Hakuvahdin poistaminen"

msgid "Extend search alert"
msgstr "Hakuvahdin jatkaminen"

# Hakuvahti confirm context

msgctxt "Hakuvahti confirm"
msgid "Confirm search alert"
msgstr "Vahvista hakuvahti"

msgctxt "Hakuvahti confirm"
msgid "Please enter the confirmation code that you received by SMS."
msgstr "Syötä vahvistuskoodi, jonka sait tekstiviestillä."

msgctxt "Hakuvahti confirm"
msgid "Activating search alert"
msgstr "Hakuvahtia aktivoidaan"

msgctxt "Hakuvahti confirm"
msgid "Activating search alert subscription…"
msgstr "Hakuvahdin tilausta aktivoidaan…"

msgctxt "Hakuvahti confirm"
msgid "Confirmation code"
msgstr "Vahvistuskoodi"

# Hakuvahti confirm success context

msgctxt "Hakuvahti confirm success"
msgid "Search alert subscription successful"
msgstr "Hakuvahdin tilaus onnistui"

msgctxt "Hakuvahti confirm success"
msgid "You will receive an email with new search matches no more than once a day."
msgstr "Saat tiedon uusista osumista korkeintaan kerran päivässä."

msgctxt "Hakuvahti confirm success"
msgid "You can cancel your subscription using the link you will receive with each notification."
msgstr "Voit perua tilauksen linkillä, jonka saat jokaisen ilmoituksen mukana."

msgctxt "Hakuvahti confirm success"
msgid "The search alert subscription is valid for six months."
msgstr "Hakuvahti on voimassa kuusi kuukautta."

# Hakuvahti confirm failure context

msgctxt "Hakuvahti confirm failure"
msgid "Search alert confirmation failed"
msgstr "Hakuvahdin vahvistus epäonnistui"

msgctxt "Hakuvahti confirm failure"
msgid "Your search alert could not be confirmed. You can try confirming the search alert again."
msgstr "Hakuvahdin vahvistus epäonnistui. Voit kokeilla vahvistaa hakuvahdin uudelleen."

# Hakuvahti already confirmed context

msgctxt "Hakuvahti already confirmed"
msgid "This search alert has already been confirmed"
msgstr "Hakuvahti on jo vahvistettu"

msgctxt "Hakuvahti already confirmed"
msgid "You have already confirmed this search alert."
msgstr "Olet jo vahvistanut tämän hakuvahdin."

msgctxt "Hakuvahti already confirmed"
msgid "You will receive email alerts about new search results up to once a day."
msgstr "Saat tiedon uusista osumista korkeintaan kerran päivässä. "

msgctxt "Hakuvahti already confirmed"
msgid "Each email contains an unsubscribe link that you can use to unsubscribe from search alerts. You can subscribe to new search alert at any time."
msgstr "Voit perua tilauksen linkillä, jonka saat jokaisen ilmoituksen mukana. Voit koska tahansa tilata uusia hakuvahteja."

# Hakuvahti renew context

msgctxt "Hakuvahti renew"
msgid "Extending your search alert subscription"
msgstr "Jatketaan hakuvahdin tilausta"

msgctxt "Hakuvahti renew"
msgid "Search alert subscription is being processed…"
msgstr "Hakuvahdin tilausta käsitellään…"

msgctxt "Hakuvahti renew"
msgid "Extend your search alert subscription"
msgstr "Jatka hakuvahdin tilausta"

# Hakuvahti renew success context

msgctxt "Hakuvahti renew success"
msgid "Search alert subscription has been extended"
msgstr "Hakuvahdin tilausta jatkettiin"

msgctxt "Hakuvahti renew success"
msgid "Your search alert subscription has been successfully extended."
msgstr "Hakuvahtisi tilausta on nyt jatkettu onnistuneesti."

# Hakuvahti renew failure context

msgctxt "Hakuvahti renew failure"
msgid "Search alert subscription could not be extended"
msgstr "Hakuvahdin tilausta ei voitu jatkaa"

msgctxt "Hakuvahti renew failure"
msgid "Search alert subscription could not be extended. It may have expired."
msgstr "Hakuvahdin tilausta ei voitu jatkaa. Tilaus saattoi olla jo vanhentunut."

# Hakuvahti unsubscribe context

msgctxt "Hakuvahti unsubscribe"
msgid "Removing search alert"
msgstr "Hakuvahtia poistetaan"

msgctxt "Hakuvahti unsubscribe"
msgid "Removing search alert subscription…"
msgstr "Hakuvahdin tilausta poistetaan…"

msgctxt "Hakuvahti unsubscribe"
msgid "Remove search alert"
msgstr "Poista hakuvahti"

# Hakuvahti unsubscribe success context

msgctxt "Hakuvahti unsubscribe success"
msgid "The search alert has been removed"
msgstr "Hakuvahti on poistettu"

msgctxt "Hakuvahti unsubscribe success"
msgid "The search alert has now been removed."
msgstr "Hakuvahti on nyt poistettu."

msgctxt "Hakuvahti unsubscribe success"
msgid "You can subscribe to new search alerts at any time."
msgstr "Voit koska tahansa tilata uusia hakuvahteja."

# Hakuvahti unsubscribe not found context

msgctxt "Hakuvahti unsubscribe not found"
msgid "Unable to find search alert"
msgstr "Hakuvahtia ei löytynyt"

msgctxt "Hakuvahti unsubscribe not found"
msgid "Search alert is either no longer valid or it has been removed."
msgstr "Hakuvahti ei ole enää voimassa tai se on jo poistettu."

# Hakuvahti unsubscribe failure context

msgctxt "Hakuvahti unsubscribe failure"
msgid "Search alert removal failed"
msgstr "Hakuvahdin poistaminen epäonnistui"

msgctxt "Hakuvahti unsubscribe failure"
msgid "Search alert removal failed You can try removing the search alert again."
msgstr "Hakuvahdin poistaminen epäonnistui. Voit kokeilla poistaa hakuvahdin uudelleen."

# Hakuvahti flood context

msgctxt "Hakuvahti flood"
msgid "Too many requests"
msgstr "Liian monta pyyntöä"

msgctxt "Hakuvahti flood"
msgid "Too many requests, please try again later."
msgstr "Liian monta pyyntöä, yritä myöhemmin uudelleen."

msgid "Hakuvahti statistics"
msgstr "Hakuvahdin tilastot"

msgid "View Hakuvahti statistics"
msgstr "Katsele hakuvahdin tilastoja"

msgid "View subscription key figures and download them as CSV."
msgstr "Katsele tilausten tunnuslukuja ja lataa ne CSV-tiedostona."

# Hakuvahti statistics context

msgctxt "Hakuvahti statistics"
msgid "Hakuvahti"
msgstr "Hakuvahti"

msgctxt "Hakuvahti statistics"
msgid "Site"
msgstr "Sivusto"

msgctxt "Hakuvahti statistics"
msgid "- Select a site -"
msgstr "- Valitse sivusto -"

msgctxt "Hakuvahti statistics"
msgid "One row per"
msgstr "Aikaväli"

msgctxt "Hakuvahti statistics"
msgid "Month"
msgstr "Kuukausi"

msgctxt "Hakuvahti statistics"
msgid "Day"
msgstr "Päivä"

msgctxt "Hakuvahti statistics"
msgid "Start date"
msgstr "Alkupäivä"

msgctxt "Hakuvahti statistics"
msgid "End date"
msgstr "Loppupäivä"

msgctxt "Hakuvahti statistics"
msgid "Leave both dates empty for the default range: this month and the 12 before it, or the last 31 days."
msgstr "Jätä molemmat päivät tyhjiksi, niin käytetään oletusjaksoa: kuluva kuukausi ja 12 sitä edeltävää, tai viimeiset 31 päivää."

msgctxt "Hakuvahti statistics"
msgid "Show"
msgstr "Näytä"

msgctxt "Hakuvahti statistics"
msgid "Download CSV"
msgstr "Lataa CSV"

msgctxt "Hakuvahti statistics"
msgid "Enter the date as YYYY-MM-DD."
msgstr "Anna päivämäärä muodossa VVVV-KK-PP."

msgctxt "Hakuvahti statistics"
msgid "End date cannot be before start date."
msgstr "Loppupäivä ei voi olla ennen alkupäivää."

msgctxt "Hakuvahti statistics"
msgid "Active subscriptions: @count"
msgstr "Aktiivisia tilauksia: @count"

msgctxt "Hakuvahti statistics"
msgid "Waiting for confirmation: @count"
msgstr "Odottaa vahvistusta: @count"

msgctxt "Hakuvahti statistics"
msgid "Showing @from to @to, one row per day."
msgstr "Näytetään @from–@to, yksi rivi päivää kohden."

msgctxt "Hakuvahti statistics"
msgid "Showing @from to @to, one row per month."
msgstr "Näytetään @from–@to, yksi rivi kuukautta kohden."

msgctxt "Hakuvahti statistics"
msgid "Nothing has been recorded for this site yet."
msgstr "Tälle sivustolle ei ole vielä kertynyt tilastoja."

msgctxt "Hakuvahti statistics"
msgid "Read at @time."
msgstr "Luettu @time."

msgctxt "Hakuvahti statistics"
msgid "No periods in range."
msgstr "Aikavälillä ei ole jaksoja."

msgctxt "Hakuvahti statistics"
msgid "Period"
msgstr "Jakso"

msgctxt "Hakuvahti statistics"
msgid "Created"
msgstr "Luotu"

msgctxt "Hakuvahti statistics"
msgid "Confirmed"
msgstr "Vahvistettu"

msgctxt "Hakuvahti statistics"
msgid "Cancelled"
msgstr "Keskeytetty"

msgctxt "Hakuvahti statistics"
msgid "Cancelled before confirming"
msgstr "Keskeytetty ennen vahvistusta"

msgctxt "Hakuvahti statistics"
msgid "Expired"
msgstr "Vanhentunut"

msgctxt "Hakuvahti statistics"
msgid "Expired before confirming"
msgstr "Vanhentunut ennen vahvistusta"

msgctxt "Hakuvahti statistics"
msgid "Net change"
msgstr "Nettomuutos"

msgctxt "Hakuvahti statistics"
msgid "Active at end"
msgstr "Aktiivisia lopussa"

msgctxt "Hakuvahti statistics"
msgid "Confirmed (@language)"
msgstr "Vahvistettu (@language)"

msgctxt "Hakuvahti statistics"
msgid "Hakuvahti is not configured on this site, so there are no statistics to read."
msgstr "Hakuvahtia ei ole määritetty tälle sivustolle, joten tilastoja ei voi hakea."

msgctxt "Hakuvahti statistics"
msgid "No Hakuvahti configuration has a site ID, so there are no statistics to read."
msgstr "Millään hakuvahtimäärityksellä ei ole sivustotunnusta, joten tilastoja ei voi hakea."

msgctxt "Hakuvahti statistics"
msgid "Hakuvahti did not accept the request. Check the site and the dates."
msgstr "Hakuvahti ei hyväksynyt pyyntöä. Tarkista sivusto ja päivämäärät."

msgctxt "Hakuvahti statistics"
msgid "Hakuvahti did not accept this site's API key."
msgstr "Hakuvahti ei hyväksynyt tämän sivuston API-avainta."

msgctxt "Hakuvahti statistics"
msgid "This site's Hakuvahti does not report statistics yet."
msgstr "Tämän sivuston hakuvahti ei vielä raportoi tilastoja."

msgctxt "Hakuvahti statistics"
msgid "Reading the statistics failed."
msgstr "Tilastojen lukeminen epäonnistui."
